; Godotwind default UI theme.
;
; Source of truth for all dialogue/book/journal/toast styling. Built in
; Phase A of the Text/Dialogue overhaul (see docs/TEXT_DIALOGUE_SYSTEM.md).
;
; See assets/ui/themes/BEFORE_STYLE_CATALOG.md for the original hand-rolled
; StyleBox values captured before this extraction — they are the acceptance
; criteria for the visual regression test.
;
; Primary font: Pelagiad (OFL 1.1, MW-themed serif). Located at
; assets/ui/fonts/pelagiad/Pelagiad.ttf.
;
; Style summary (all values verified against source 2026-04-06):
;   Parchment        bg #E8DEC7 / border #735940 w3 / radius 4 / padding 20
;   ParchmentTight   bg #E8DEC7 / border #735940 w2 / radius 4 / padding 15
;   Toast            bg #1F1914@0.9 / border #998059 w1 / radius 6 / padding 12
;   TopicsList       bg #1F1F26 / border #4D4D66 w2 / radius 4 / padding 10
;   ParchmentSep     bg #735940@0.5, margin_top/bottom 1
;
; Applied to panels via `theme = preload("res://assets/ui/themes/default_theme.tres")`
; and (for ParchmentTight/Toast/TopicsList) `theme_type_variation = "..."`.

[gd_resource type="Theme" load_steps=11 format=3]

[ext_resource type="FontFile" path="res://assets/ui/fonts/pelagiad/Pelagiad.ttf" id="1_font"]

[sub_resource type="StyleBoxFlat" id="SB_Parchment"]
content_margin_left = 20.0
content_margin_top = 20.0
content_margin_right = 20.0
content_margin_bottom = 20.0
bg_color = Color(0.91, 0.87, 0.78, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.45, 0.35, 0.25, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="SB_ParchmentTight"]
content_margin_left = 15.0
content_margin_top = 15.0
content_margin_right = 15.0
content_margin_bottom = 15.0
bg_color = Color(0.91, 0.87, 0.78, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.45, 0.35, 0.25, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="SB_Toast"]
content_margin_left = 12.0
content_margin_top = 12.0
content_margin_right = 12.0
content_margin_bottom = 12.0
bg_color = Color(0.12, 0.1, 0.08, 0.9)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.6, 0.5, 0.35, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="SB_TopicsList"]
content_margin_left = 10.0
content_margin_top = 10.0
content_margin_right = 10.0
content_margin_bottom = 10.0
bg_color = Color(0.12, 0.12, 0.15, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.3, 0.3, 0.4, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="SB_ParchmentSep"]
content_margin_top = 1.0
content_margin_bottom = 1.0
bg_color = Color(0.45, 0.35, 0.25, 0.5)

[sub_resource type="StyleBoxEmpty" id="SB_Empty"]

[sub_resource type="StyleBoxEmpty" id="SB_Empty2"]

[sub_resource type="StyleBoxEmpty" id="SB_Empty3"]

[resource]
default_font = ExtResource("1_font")
default_font_size = 18
PanelContainer/styles/panel = SubResource("SB_Parchment")
ParchmentTight/base_type = "PanelContainer"
ParchmentTight/styles/panel = SubResource("SB_ParchmentTight")
Toast/base_type = "PanelContainer"
Toast/styles/panel = SubResource("SB_Toast")
TopicsList/base_type = "PanelContainer"
TopicsList/styles/panel = SubResource("SB_TopicsList")
ParchmentSeparator/base_type = "HSeparator"
ParchmentSeparator/styles/separator = SubResource("SB_ParchmentSep")
Label/colors/font_color = Color(0.15, 0.1, 0.05, 1)
TitleLabel/base_type = "Label"
TitleLabel/colors/font_color = Color(0.25, 0.15, 0.1, 1)
TitleLabel/font_sizes/font_size = 26
DispositionLabel/base_type = "Label"
DispositionLabel/colors/font_color = Color(0.6, 0.7, 0.6, 1)
ToastLabel/base_type = "Label"
ToastLabel/colors/font_color = Color(0.9, 0.85, 0.7, 1)
RichTextLabel/colors/default_color = Color(0.15, 0.1, 0.05, 1)
RichTextLabel/styles/normal = SubResource("SB_Empty")
RichTextLabel/styles/focus = SubResource("SB_Empty2")
CloseButton/base_type = "Button"
CloseButton/font_sizes/font_size = 22
CloseButton/styles/normal = SubResource("SB_Empty3")
